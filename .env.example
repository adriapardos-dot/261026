# Copia este archivo como .env.local y rellena los valores.
# NUNCA uses el prefijo NEXT_PUBLIC_ para estas variables: se incrustarían en
# el JavaScript del navegador.

# URL del proyecto (Dashboard → Project Settings → Data API).
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave secreta (Dashboard → Project Settings → API Keys → Secret keys, sb_secret_…).
# Salta RLS: solo se usa en los Route Handlers del servidor.
SUPABASE_SECRET_KEY=

# Alternativa heredada si tu proyecto aún no tiene claves nuevas:
# SUPABASE_SERVICE_ROLE_KEY=

# Mapa (MapTiler, estilo Ocean v4). Esta SÍ es pública: va al navegador.
# Restríngela por dominio en cloud.maptiler.com → Account → Keys.
NEXT_PUBLIC_MAPTILER_KEY=

# La app no tiene autenticación. En producción (next start) los endpoints de
# Supabase devuelven 403 salvo que pongas "true" aquí. Hazlo solo si has
# protegido antes el acceso (autenticación, red privada, etc.).
# ETL_PERMITIR_SIN_AUTENTICACION=false
